{
  "name": "weight-loss-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node --env-file-if-exists=.env scripts/turso-migrations.js --check --build-gate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:migrations:check": "node --env-file-if-exists=.env scripts/turso-migrations.js --check --force",
    "db:migrations:apply": "node --env-file-if-exists=.env scripts/turso-migrations.js --apply --force",
    "db:migrations:seal": "node scripts/turso-migrations.js --seal",
    "test:migrations": "node --test scripts/turso-migrations.test.js",
    "test:weekly-check-in": "tsx --test scripts/weekly-check-in.test.ts",
    "test:ui:mobile": "node scripts/dashboard-mobile-check.js",
    "test:ui:admin": "node scripts/admin-clickthrough.js"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-libsql": "^7.4.2",
    "@prisma/client": "^6.6.0",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^2.4.3",
    "heic2any": "^0.0.4",
    "next": "^15.2.0",
    "next-auth": "^4.24.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-easy-crop": "^6.2.3",
    "recharts": "^2.15.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "prisma": "^6.6.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.8.2"
  }
}
